# Copia a .env (no se versiona). Ver cuadra/PLAN.md sección 16.
PORT=8086  # solo desarrollo local (Railway usa 8080)
DB_URL=jdbc:postgresql://localhost:5435/cuadra
DB_USER=cuadra
DB_PASSWORD=cuadra

# IDs de cliente OAuth de Google (web y Android), separados por coma. Sin ellos, nadie puede iniciar sesión.
GOOGLE_CLIENT_IDS=

SUPPORT_INBOX_EMAIL=ndiazobed@gmail.com
PLATFORM_ADMIN_EMAILS=ndiazobed@gmail.com
APP_BASE_URL=http://localhost:5173

# "Invítame un café": external_link | play_billing | hidden
# (por defecto ya viene PayPal; ver application.yml)
#DONATION_URL=
#DONATION_MODE=external_link
MIN_APP_VERSION=0

# Orígenes del panel web que pueden llamar a la API (solo https reales en producción; el valor de desarrollo ya viene por defecto)
#CUADRA_CORS_ORIGINS=https://obed-navarreted.github.io
# Producción: CUADRA_ENV=prod y ver docs/notas/despliegue.md (hash de la consola, proxy de confianza, etc.)
#CUADRA_ENV=prod
